# ───────── Required ─────────
# Anthropic API key (https://console.anthropic.com → API Keys). Server-side only.
ANTHROPIC_API_KEY=
# Password you type to log in to your private tutor.
APP_PASSWORD=
# Long random string used to sign the login cookie. Generate: openssl rand -base64 48
AUTH_SECRET=

# ───────── Optional: Claude tuning ─────────
# CLAUDE_MODEL=claude-opus-5-5
# Effort for live conversation turns (low = fastest replies). low | medium | high
# CLAUDE_CHAT_EFFORT=low
# Effort for lesson planning and end-of-session assessment.
# CLAUDE_ANALYSIS_EFFORT=medium
# Server-side refusal fallback (on by default for supported models). Set to "off" to disable.
# CLAUDE_FALLBACKS=on

# ───────── Optional: persistent database (recommended for cloud hosting) ─────────
# Without these, data is saved to ./data/tutor-db.json (works for local / VPS / Docker, NOT for Vercel).
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# DATA_DIR=./data

# ───────── Optional: cloud voice (works in every browser) ─────────
# If set, the app can use OpenAI speech-to-text + text-to-speech instead of the browser's built-in voice.
# OPENAI_API_KEY=
# OPENAI_STT_MODEL=gpt-4o-mini-transcribe
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=coral
# OPENAI_BASE_URL=https://api.openai.com/v1
